rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isDemoOrder(orderId, order) {
      let fields = ['id', 'placedAt', 'items', 'count', 'total'];
      return order.keys().hasAll(fields) && order.keys().hasOnly(fields)
        && order.id == orderId
        && orderId.matches('^DEMO-([0-9A-F]{4}-){2}[0-9A-F]{4}$')
        && order.placedAt is string
        && order.placedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$')
        && order.count is int && order.count > 0 && order.count <= 9007199254740991
        && order.items is list && order.items.size() > 0 && order.items.size() <= order.count
        && order.total is number && order.total >= 0 && order.total <= 9007199254740991;
    }

    match /categories/{categoryId} {
      allow get, list: if true;
    }

    match /users/{uid} {
      allow get, create, update: if isOwner(uid);

      match /demoOrders/{orderId} {
        allow get, list: if isOwner(uid);
        allow create: if isOwner(uid) && isDemoOrder(orderId, request.resource.data);
      }
    }
  }
}
